{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Not the dashboard. latere.space is served by the box behind a Cloudflare
  // tunnel; this Worker has one job, on a schedule, and answers no requests.
  //
  // Deliberately no route, no custom domain, no assets, and workers_dev off. A
  // Worker that answers on a hostname is a Worker that can serve an internal
  // console without the Access check the tunnel hostname carries.
  "name": "nonyxa-asc-feed",
  "compatibility_date": "2025-01-01",
  "main": "worker/index.ts",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  // One read a day of Apple's ONGOING analytics feed, which it stops
  // generating if nothing reads it. See worker/index.ts.
  "triggers": {
    "crons": ["17 8 * * *"]
  },
  "vars": {
    "ASC_APP_ID": "6778487881"
  }
}
