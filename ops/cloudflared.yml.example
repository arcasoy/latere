# Copy to /etc/cloudflared/config.yml and fill in the tunnel id.
#
# cloudflared dials Cloudflare outbound, so the box needs no inbound ports and
# no public IP exposure — close 80 and 443 in the firewall and leave them shut.
tunnel: TUNNEL_ID
credentials-file: /etc/cloudflared/TUNNEL_ID.json

ingress:
  - hostname: latere.space
    service: http://127.0.0.1:5173
    originRequest:
      # Cloudflare cuts an origin response at 100s regardless of what is set
      # here, which is why /api/generate starts the render and returns rather
      # than waiting for it. These only cover connect and idle time.
      connectTimeout: 30s
      noTLSVerify: false
  - service: http_status:404
