# The console's credentials. Two homes, same names:
#
#   locally  — copy to .env (gitignored) for `npm run dev:server`
#   the box  — /etc/latere/latere.env, root-owned and 0640, read by latere.service
#
# The cron Worker reads ASC_* from `wrangler secret` instead;
# nothing in this file is uploaded by a deploy.

# ── The gate ───────────────────────────────────────────────────────────────
# The Access application's AUD tag and the Zero Trust team name. Not secrets —
# the JWT they validate is what carries the authority — but the server refuses
# to serve anything without them. From Zero Trust → Access → Applications.
ACCESS_TEAM_DOMAIN=arcasoy
ACCESS_AUD=

# Waives the Access check, and only for a request that named a loopback host.
# Local dev only — `npm run dev:server` sets it. Never put it in latere.service.
# GTM_DEV_BYPASS=1

# ── Acquisition panel ──────────────────────────────────────────────────────
# App Store Connect. The first four are in ops/asc/.env.asc; the key is the
# body of the .p8 — headers optional, newlines optional.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_VENDOR_NUMBER=
ASC_PRIVATE_KEY=
ASC_APP_ID=6778487881

# RevenueCat v2 secret key (sk_…) from Project settings → API keys. The
# project id is an identifier, not a credential — it is in every dashboard URL.
REVENUECAT_API_KEY=
REVENUECAT_PROJECT_ID=proj7177f1b7

# ── Content section ────────────────────────────────────────────────────────
# Buffer access token from https://publish.buffer.com/settings/api
BUFFER_ACCESS_TOKEN=

# Publish mode for the loop / autonomous run:
#   draft    (default, safe) — creates Buffer drafts, never posts
#   schedule — adds to the Buffer queue (posts at your Buffer queue times)
#   live     — posts immediately
LATERE_PUBLISH_MODE=draft

# Seconds between autonomous ticks (the "wait until next post" interval)
LATERE_INTERVAL_SEC=1800

# Optional: pin a specific Buffer channel id (else ALL connected channels)
# BUFFER_CHANNEL_ID=
# Optional: limit publishing to these services (comma-separated)
# LATERE_PUBLISH_CHANNELS=instagram,tiktok

# --- autonomy guardrails (all optional; sane defaults) ---
# Max variants created per UTC day — the hard brake on unattended runs
LATERE_DAILY_POST_CAP=6
# Max variants rendered+published per loop tick
LATERE_RENDERS_PER_TICK=1
# Keep at least this many still images in the slideshow background pool
LATERE_IMAGE_POOL_MIN=8
# Max AI image generations per UTC day (~$0.04 each on gemini-2.5-flash-image)
LATERE_IMAGE_DAILY_CAP=12

# The handle stamped on every render (brand chip)
LATERE_BRAND=@getnonyxa

# Latere's dedicated Supabase project. Never use the Nonyxa app project here.
# Secret key stays on the server. The media bucket contains public content assets.
LATERE_SUPABASE_URL=https://pysmppmptbufenjzoeus.supabase.co
LATERE_SUPABASE_SECRET_KEY=

# LLM + image generation (OpenRouter — openrouter.ai/keys). One key covers hooks,
# slide copy, AND slideshow background images. Every call logs its dollar cost.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# Generated photos always wait for approval in the console.
# Per-platform daily publish caps (service:count); channels at cap are skipped
LATERE_CHANNEL_DAILY_CAPS=instagram:3,tiktok:10,youtube:3
